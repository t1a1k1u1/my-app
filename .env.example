# Environment variables declared in this file are NOT automatically loaded by Prisma;
# prisma.config.ts loads them explicitly via `import "dotenv/config"`.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://user:password@localhost:5432/tabegoro?schema=public"

# NextAuth.js (Auth.js v5) — generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Vercel Blob — used by src/lib/storage.ts to store ingredient icon images.
# On Vercel, this is injected automatically once a Blob store is attached to
# the project. For local dev, create a store in the Vercel dashboard
# (Storage → Blob) and copy its read-write token here, or run
# `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
