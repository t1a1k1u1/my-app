// たべごろ - Prisma schema
// See docs/spec.md §5 for the entity definitions this mirrors.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 利用者（開発者本人のみ想定）
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  stockItems StockItem[]

  @@map("users")
}

/// 食材マスター
model Ingredient {
  id            String   @id @default(uuid())
  name          String
  iconImageUrl  String?  @map("icon_image_url")
  expiryDays    Int      @map("expiry_days")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  aliases    IngredientAlias[]
  stockItems StockItem[]

  @@index([name])
  @@map("ingredients")
}

/// 食材別名（検索用シノニム）
model IngredientAlias {
  id           String @id @default(uuid())
  ingredientId String @map("ingredient_id")
  aliasName    String @map("alias_name")

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([ingredientId])
  @@index([aliasName])
  @@map("ingredient_aliases")
}

/// 在庫（論理削除方式）
model StockItem {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  ingredientId String    @map("ingredient_id")
  registeredAt DateTime  @db.Date @map("registered_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([userId, deletedAt])
  @@index([ingredientId])
  @@map("stock_items")
}
